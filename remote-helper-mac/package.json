{
  "name": "wiretalk-remote-helper-mac",
  "version": "0.1.0",
  "private": true,
  "description": "Wiretalk Remote Helper for macOS — shares the desktop and accepts agent remote control.",
  "main": "main.js",
  "author": "Wiretalk",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir --mac",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wiretalk.remotehelper",
    "productName": "Wiretalk Remote Helper",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": ["dmg"],
      "artifactName": "WiretalkRemoteHelper-${version}-mac.dmg",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
